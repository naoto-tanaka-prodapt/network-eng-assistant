meta {
  name: identify-problem
  type: http
  seq: 2
}

post {
  url: http://localhost:8000/api/identify
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  query: '''
    ユーザPCがネットワークに接続できない。
    NICのリンクランプが点灯していない。
    同じ壁ジャックに別PCを接続してもリンクアップしない。
    スイッチ側ポートのLEDも反応なし。
    昨日までは正常に使用できていた。
  '''
  session_id: 111
}

settings {
  encodeUrl: true
  timeout: 0
}
