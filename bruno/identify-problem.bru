meta {
  name: identify-problem
  type: http
  seq: 2
}

post {
  url: http://localhost:8000/api/identify
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  query: '''
    Several users in the west side of the 3rd floor cannot connect to the corporate file server.
    The service was working normally from this location yesterday.
    
    On the affected PCs, the Ethernet cable is plugged in, but the NIC link light is off or intermittently dropping.
    Windows sometimes reports “network cable unplugged,” and the stations are not receiving an IP address.
    
    We have already performed a cold boot on one of the affected machines, but the problem persists.
    We have not yet run an inline test or Auto Test.
    
    There was patch cable work done in this area last night, and the issue seems limited to a small group of nearby stations.
  '''
  session_id: 101
}

settings {
  encodeUrl: true
  timeout: 0
}
